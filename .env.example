# Shared development settings
NODE_ENV=development

# API
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/yatra_verse
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-minimum-development-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
USE_DEVELOPMENT_PROVIDERS=true

# Email verification. Leave SMTP values unset in local development: OTP codes are
# printed to the API terminal only. For Gmail, use an App Password, never your
# regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-google-workspace-or-gmail-address@example.com
SMTP_PASS=your-16-character-gmail-app-password
EMAIL_FROM=YATRA VERSE <your-google-workspace-or-gmail-address@example.com>

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
