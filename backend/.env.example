EMAIL_USER=pandeysp8080@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_FROM=YatraVerse <pandeysp8080@gmail.com>
# TomTom Traffic API key. Keeps live traffic and nearby incident/diversion data on the server.
TOMTOM_TRAFFIC_API_KEY=
